# ============================================================================
# OaxIntegra IA — Webhook de WhatsApp
# ----------------------------------------------------------------------------
# Copia este archivo a .env y pon tus datos:
#     cp .env.example .env
# El .env NUNCA se sube a GitHub (ya está en .gitignore).
# ============================================================================

# --- 1. El token de verificación -------------------------------------------
# Te lo inventas tú. Es el mismo que vas a pegar en Meta en "Verify token".
# Tiene que coincidir letra por letra.
WEBHOOK_VERIFY_TOKEN=oax_token_secreto_2026

# --- 2. Los datos de tu WhatsApp -------------------------------------------
# Se sacan en developers.facebook.com → tu app → WhatsApp → API Setup
WHATSAPP_TOKEN=tu_token_aqui
WHATSAPP_PHONE_ID=tu_phone_id_aqui

# --- 3. Para comprobar que los avisos vienen de Meta ------------------------
# developers.facebook.com → tu app → Configuración → Básica → Clave secreta
# Sin esto, cualquiera que sepa tu dirección puede inventarse mensajes.
WHATSAPP_APP_SECRET=

# --- 4. Para exponerlo a internet con ngrok (opcional) ----------------------
# Gratis en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- 5. Opcionales ----------------------------------------------------------
# PORT=8080
# GRAPH_VERSION=v21.0

# Para buscar huipiles también con Google (opcional).
# Sin esto usa Wikimedia Commons, que trae licencia y autor comprobables.
# GOOGLE_API_KEY=
# GOOGLE_CX=
