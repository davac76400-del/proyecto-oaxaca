# ============================================================================
# OaxIntegra IA — Llaves de acceso a la inteligencia artificial
# ----------------------------------------------------------------------------
# CÓMO USAR ESTE ARCHIVO:
#   1. Haz una copia con el nombre .env   →   cp .env.example .env
#   2. Pega tus llaves en esa copia
#   3. Arranca:  node backend/servidor.js
#
# ⚠️ El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).
#    Este .env.example sí se sube, pero solo con los espacios en blanco.
#    Nunca pegues una llave de verdad aquí.
#
# Al publicar, estas mismas variables se cargan en el panel del servicio:
#   Netlify → Site settings → Environment variables
#   Vercel  → Project Settings → Environment Variables
# ============================================================================


# --- 1. LLAMA 3.2 · el ayudante principal (gratis) --------------------------
# Sácala en: https://openrouter.ai/keys
# Empieza con "sk-or-v1-"
OPENROUTER_API_KEY=


# --- 2. GEMINI FLASH · el respaldo (gratis) ---------------------------------
# Sácala en: https://aistudio.google.com/apikey
# Empieza con "AIza"
GEMINI_API_KEY=


# ============================================================================
# VERIFICAR EL TELÉFONO POR WHATSAPP
# ----------------------------------------------------------------------------
# Por dónde se manda el código. Deja 'consola' para probar: no manda nada,
# escribe el código en la terminal del servidor y así lo puedes ver.
#   consola | meta | twilio | n8n
# Paso a paso de cada uno: docs/08-whatsapp-otp.md
# ============================================================================
WHATSAPP_PROVEEDOR=consola

# --- si eliges 'meta' (WhatsApp Cloud API, la oficial y la recomendada) -----
# Se sacan en https://developers.facebook.com → tu app → WhatsApp → API Setup
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_PLANTILLA=codigo_acceso     ← el nombre de tu plantilla aprobada
# WHATSAPP_IDIOMA=es_MX

# --- si eliges 'twilio' -----------------------------------------------------
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- si eliges 'n8n' (tu propio flujo) --------------------------------------
# N8N_WHATSAPP_URL=https://tu-cuenta.app.n8n.cloud/webhook/whatsapp
# N8N_SECRETO=inventa-aqui-una-contrasena-larga

# --- una contraseña larga tuya, para proteger los códigos guardados ---------
# Invéntala. Si la cambias, los códigos que estuvieran en curso dejan de valer.
# OTP_SECRETO=

# --- afinado del código (opcional) ------------------------------------------
# OTP_VIGENCIA_MIN=10      minutos que dura el código
# OTP_MAX_INTENTOS=5       cuántas veces puede equivocarse
# OTP_ESPERA_SEG=60        espera entre un envío y el siguiente
# OTP_MAX_POR_HORA=5       máximo de códigos por número en una hora


# ============================================================================
# DE AQUÍ PARA ABAJO ES OPCIONAL — funciona bien sin tocar nada
# ============================================================================

# El modelo que SÍ SABE VER, para cuando alguien manda una foto.
# El de texto no puede con imágenes; por eso son dos.
# OPENROUTER_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct:free

# Puerto del servidor de tu computadora
# PORT=3000

# Si algún día OpenRouter retira el modelo, cámbialo aquí sin tocar el código.
# Busca uno que termine en ":free" en https://openrouter.ai/models?q=llama
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Modelo de Gemini
# GEMINI_MODEL=gemini-2.0-flash

# Cuántos segundos esperar a cada ayudante antes de pasar al siguiente
# IA_TIMEOUT_MS=20000

# La dirección pública de tu sitio (OpenRouter la pide para identificar la app)
# PUBLIC_URL=https://tu-sitio.netlify.app

# ============================================================================
# WEBHOOK DE WHATSAPP  ·  para RECIBIR mensajes y fotos
# ----------------------------------------------------------------------------
# Esto es lo que arranca con:  npm start
# Guía completa: docs/10-webhook-whatsapp.md
# ============================================================================

# El token de verificación. Te lo inventas tú y es el MISMO que pegas en Meta.
WEBHOOK_VERIFY_TOKEN=oax_token_secreto_2026

# Se sacan en developers.facebook.com -> tu app -> WhatsApp -> API Setup
# (WHATSAPP_TOKEN y WHATSAPP_PHONE_ID son los mismos que usa el envío de códigos)
WHATSAPP_APP_SECRET=

# Para exponerlo a internet con ngrok (opcional).
# Gratis en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Puerto del webhook
# PORT=8080
# GRAPH_VERSION=v21.0

# Para buscar huipiles también con Google (opcional).
# Sin esto usa Wikimedia Commons, que trae licencia y autor comprobables.
# GOOGLE_API_KEY=
# GOOGLE_CX=
