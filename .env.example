# ============================================================================
# OaxIntegra IA — Llaves de acceso a la inteligencia artificial
# ----------------------------------------------------------------------------
# CÓMO USAR ESTE ARCHIVO:
#   1. Haz una copia con el nombre .env   →   cp .env.example .env
#   2. Pega tus llaves en esa copia
#   3. Arranca:  node backend/servidor.js
#
# ⚠️ El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).
#    Este .env.example sí se sube, pero solo con los espacios en blanco.
#    Nunca pegues una llave de verdad aquí.
#
# Al publicar, estas mismas variables se cargan en el panel del servicio:
#   Netlify → Site settings → Environment variables
#   Vercel  → Project Settings → Environment Variables
# ============================================================================


# --- 1. LLAMA 3.2 · el ayudante principal (gratis) --------------------------
# Sácala en: https://openrouter.ai/keys
# Empieza con "sk-or-v1-"
OPENROUTER_API_KEY=


# --- 2. GEMINI FLASH · el respaldo (gratis) ---------------------------------
# Sácala en: https://aistudio.google.com/apikey
# Empieza con "AIza"
GEMINI_API_KEY=


# ============================================================================
# DE AQUÍ PARA ABAJO ES OPCIONAL — funciona bien sin tocar nada
# ============================================================================

# Puerto del servidor de tu computadora
# PORT=3000

# Si algún día OpenRouter retira el modelo, cámbialo aquí sin tocar el código.
# Busca uno que termine en ":free" en https://openrouter.ai/models?q=llama
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Modelo de Gemini
# GEMINI_MODEL=gemini-2.0-flash

# Cuántos segundos esperar a cada ayudante antes de pasar al siguiente
# IA_TIMEOUT_MS=20000

# La dirección pública de tu sitio (OpenRouter la pide para identificar la app)
# PUBLIC_URL=https://tu-sitio.netlify.app
