# ============================================================================
# OaxIntegra IA — configuración
# ----------------------------------------------------------------------------
# CÓMO USAR ESTE ARCHIVO:
#   1. Haz una copia con el nombre .env   →   cp .env.example .env
#   2. Pega tus datos en esa copia
#   3. Construye la app:  cd frontend && python3 build.py
#   4. Arranca:           npm start
#
# ⚠️ El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).
#    Este .env.example sí se sube, pero solo con los espacios en blanco.
#    Nunca pegues un dato real aquí.
#
# Al publicar, estas mismas variables se cargan en el panel del servicio:
#   Netlify → Site settings → Environment variables
#   Vercel  → Project Settings → Environment Variables
# ============================================================================


# ============================================================================
# 1 · ENTRAR CON UN ENLACE POR CORREO  (Supabase)
# ----------------------------------------------------------------------------
# Se sacan en:  supabase.com → tu proyecto → Settings → API
# Paso a paso completo: docs/08-acceso-por-codigo.md
# ============================================================================

# La dirección de tu proyecto. Se ve así: https://abcdefghijk.supabase.co
SUPABASE_URL=

# La llave "anon public". Empieza con "eyJ".
#
# ESTA SÍ VA EN EL NAVEGADOR y no pasa nada: está hecha para ser pública.
# Lo que protege tus datos son las políticas de Row Level Security que
# configuras en Supabase, no esconder esta llave.
#
# La OTRA llave del panel, la "service_role", NO SE PONE AQUÍ NUNCA.
# Esa se salta todas las reglas de seguridad. El build.py se detiene solo
# si detecta que alguien la puso por error.
SUPABASE_ANON_KEY=


# ============================================================================
# 2 · LA INTELIGENCIA ARTIFICIAL
# ----------------------------------------------------------------------------
# Estas dos SÍ son secretas y viven solo en el servidor. El navegador nunca
# las ve: solo le pregunta a /api/ia. Guía: docs/06-ia-directa.md
# ============================================================================

# --- Llama 3.2 · el ayudante principal (gratis) -----------------------------
# Sácala en: https://openrouter.ai/keys      Empieza con "sk-or-v1-"
OPENROUTER_API_KEY=

# --- Gemini Flash · el respaldo (gratis) ------------------------------------
# Sácala en: https://aistudio.google.com/apikey
# Empieza con "AIza" o con "AQ." según cómo te la dé Google. Las dos sirven.
GEMINI_API_KEY=


# ============================================================================
# DE AQUÍ PARA ABAJO ES OPCIONAL — funciona bien sin tocar nada
# ============================================================================

# El modelo que SÍ SABE VER, para cuando alguien manda una foto.
# El de texto no puede con imágenes; por eso son dos.
# OPENROUTER_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct:free

# Puerto del servidor de tu computadora
# PORT=3000

# Si algún día OpenRouter retira el modelo, cámbialo aquí sin tocar el código.
# Busca uno que termine en ":free" en https://openrouter.ai/models?q=llama
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Modelo de Gemini. Google retira los viejos sin avisar: si un día contesta
# "no longer available", pide la lista de los que sí viven y pon uno de ahí:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=TU_LLAVE"
# GEMINI_MODEL=gemini-3.6-flash

# Cuántos segundos esperar a cada ayudante antes de pasar al siguiente
# IA_TIMEOUT_MS=20000

# Gemini piensa antes de escribir y ese pensar se cobra del mismo tope que la
# respuesta. Si notas que corta las frases a media palabra, sube el tope.
# GEMINI_MAX_TOKENS=2500
# Cuánto puede pensar: low, medium o high. Vacío = que Google decida.
# GEMINI_THINKING=low

# La dirección pública de tu sitio (OpenRouter la pide para identificar la app)
# PUBLIC_URL=https://tu-sitio.netlify.app

# Para buscar fotos de huipiles con Google (opcional).
# Sin esto, frontend/traer_huipiles.py usa Wikimedia Commons, que trae
# licencia y autor comprobables. Guía: docs/09-fotos-huipiles.md
# GOOGLE_API_KEY=
# GOOGLE_CX=
